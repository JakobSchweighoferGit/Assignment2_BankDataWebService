@{
}
@model PresentationLayerAPI.Models.Request.GetUserInformationResponse

<div>
    <h2>Edit User Profile</h2>

    <div class="grid" style="display:grid;gap:12px;max-width:520px;">

        <label>
            Handle
            <input id="ap_handle" value="@Model.Handle" readonly />
        </label>

        <label>
            First name
            <input id="ap_firstName" value="@Model.FirstName" />
        </label>

        <label>
            Last name
            <input id="ap_lastName" value="@Model.LastName" />
        </label>

        <label>
            Email
            <input id="ap_email" type="email" value="@Model.Email" />
        </label>

        <label>
            Phone
            <input id="ap_phone" type="tel" value="@Model.Phone" />
        </label>

        <label>
            Address
            <input id="ap_address" value="@Model.Address" />
        </label>

        <label>
            Profile picture
            <input id="ap_picture" value="@Model.PicturePath" />
        </label>

        <label>
            Password
            <input id="ap_newPassword" value="@Model.Password" />
        </label>

        <input type="hidden" id="ap_SearchString" value="" />

        <div style="margin-top:12px;">
            <button type="button" id="ap_updateBtn" onclick="updateUserProfile()">Update</button>
            <button type="button" id="UserManagmentnButton" onclick="searchForUserWithSearchString()">Back</button>
        </div>
    </div>
</div>

