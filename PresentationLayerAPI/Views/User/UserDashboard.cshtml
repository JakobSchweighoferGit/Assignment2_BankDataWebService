<table>
    <thead>
        <tr>
            <th>TransactionID</th>
            <th>Date</th>
            <th>Amount</th>
            <th>AccountID</th>
            <th>UserID</th>
        </tr>
    </thead>
    <tbody>
        @if (userList.Count == 0)
        {
            <tr><td colspan="3">No result</td></tr>
        }
        else
        {
            foreach (var u in userList)
            {
                <tr>
                    <td>@u.Handle</td>
                    <td>@u.Email</td>
                    <td> <button type="button" onclick="openEditUserPage('@u.Handle')">Edit User</button> </td>
                    <td>@u.AccNumber </td>
                    <td>@u.AccountID </td>
                    <td>
                        @if (u.AccountID.HasValue && u.AccountID > 0)
                        {
                            <button type="button" onclick="openEditBankAccount(@u.AccountID.Value)">Edit BankAccount</button>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>




                    TransactionID INTEGER PRIMARY KEY AUTOINCREMENT,
                            Date          TEXT        NOT NULL DEFAULT (datetime('now')),
                            Amount        INTEGER     NOT NULL,
                            Type          TEXT        NOT NULL,
                            Success       BOOLEAN     NOT NULL DEFAULT 1,
                            AccountID     INTEGER     NOT NULL,
                            UserID 